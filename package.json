{
  "name": "dorm-repair-requests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15 <26"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p packages/repair-queue && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke": "node --test test/smoke.test.js",
    "check": "npm run format:check && npm run lint && npm run build && npm run smoke",
    "hooks:install": "sh scripts/install-hooks.sh",
    "migrate": "node dist/migrate-cli.js",
    "verify:db": "sh scripts/with-db.sh node --test test/postgres-verification.test.js",
    "db:indexes": "node dist/indexes-cli.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@stryker-mutator/core": "10.1.1",
    "eslint": "9.39.3",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "workspaces": [
    "packages/repair-queue"
  ],
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.9"
    },
    "typed-rest-client": {
      "qs": "6.17.1"
    }
  }
}
